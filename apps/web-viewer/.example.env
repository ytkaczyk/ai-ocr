# Data Folder Configuration
# Path to the directory containing document sets (PDF + language folders)
DATA_FOLDER_PATH=./data

# PDF Configuration
# Maximum allowed PDF file size in megabytes (default: 50MB)
MAX_PDF_SIZE_MB=50

# Memory Configuration
# Maximum memory usage in megabytes (default: 500MB)
MEMORY_LIMIT_MB=500

# Next.js public variables (accessible in browser)
NEXT_PUBLIC_PDF_WORKER_SRC=/pdf.worker.mjs